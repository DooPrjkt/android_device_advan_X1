type vendor_sysfs_touchpanel, fs_type, sysfs_type;

allow hal_power_default vendor_sysfs_touchpanel:dir search;
allow hal_power_default vendor_sysfs_touchpanel:file rw_file_perms;
rw_dir_file(hal_power_default, sysfs_ged)

# Allow libperfmgr to control MTK CPU Memory Latency Management
allow hal_power_default sysfs_cm_mgr:dir r_dir_perms;
allow hal_power_default sysfs_cm_mgr:file rw_file_perms;
